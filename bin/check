#!/bin/sh
# Compile, lint, and test. `--full` also runs the real-tmux rig (needs docker; slow).
set -e
cd "$(dirname "$0")/.."
. bin/lib/preflight.sh
preflight_node
preflight_deps

# One command per line: `set -e` ignores a failure anywhere but last in an `&&` list.
npm run compile:src
npm run lint
npm test

if [ "${1:-}" = "--full" ]; then
  npm run test:tmux
fi
